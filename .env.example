APP_ENV=development
APP_DEBUG=false
# Em producao, use true apenas no primeiro acesso apos um deploy com migration nova.
APP_AUTO_MIGRATE=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Informe apenas proxies reversos controlados; vazio usa REMOTE_ADDR diretamente.
APP_TRUSTED_PROXIES=

# EasyHost fornece MySQL. Copie estes dados do painel da hospedagem.
DB_DRIVER=mysql
DB_HOST=mysql.seu-servidor.easyhost.be
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USERNAME=usuario_do_banco
DB_PASSWORD=change-me-database-password
DB_CHARSET=utf8mb4

# Para desenvolvimento com PostgreSQL, use DB_DRIVER=pgsql e DB_SSLMODE=require.
DB_SSLMODE=prefer

JWT_SECRET=change-me-jwt-secret-with-at-least-32-characters
JWT_EXPIRATION_MINUTES=180
# Em producao, o cookie de sessao deve permanecer Secure=true.
AUTH_COOKIE_SECURE=false
# Opcional: use um segredo diferente do JWT_SECRET para anonimizar os buckets de limite.
RATE_LIMIT_SECRET=change-me-rate-limit-secret-with-at-least-32-characters
AUTH_LOGIN_ACCOUNT_ATTEMPTS=5
AUTH_LOGIN_IP_ATTEMPTS=30
AUTH_RECOVERY_ACCOUNT_ATTEMPTS=3
AUTH_RECOVERY_IP_ATTEMPTS=20
AUTH_RESET_TOKEN_ATTEMPTS=5
AUTH_RESET_IP_ATTEMPTS=20

# URL usada nos links dos e-mails de recuperacao.
APP_FRONTEND_URL=http://localhost:4200

# log guarda apenas metadados seguros na aplicacao; mail usa mail(); smtp usa as opcoes abaixo.
MAIL_TRANSPORT=log
MAIL_FROM=noreply@chambre-rose.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Web Push (VAPID). Gere uma chave exclusiva por ambiente e nunca publique a chave privada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chambre-rose.com
# Opcional; vazio usa JWT_SECRET para assinar a identidade local do dispositivo.
PUSH_DEVICE_COOKIE_SECRET=
# Fila persistente: tentativas exponenciais de 15s ate 1h, processadas pelo worker/cron.
PUSH_OUTBOX_MAX_ATTEMPTS=8
PUSH_OUTBOX_BATCH_SIZE=20
PUSH_OUTBOX_POLL_SECONDS=2
PUSH_OUTBOX_LOCK_SECONDS=120
PUSH_OUTBOX_RETRY_BASE_SECONDS=15
PUSH_OUTBOX_RETRY_MAX_SECONDS=3600

# Retencao do historico: lidas expiram antes; nao lidas recebem uma janela maior.
# O worker nunca remove notificacoes com Push pendente, em processamento ou em retry.
NOTIFICATION_READ_RETENTION_DAYS=90
NOTIFICATION_UNREAD_RETENTION_DAYS=365
NOTIFICATION_RETENTION_BATCH_SIZE=500
NOTIFICATION_RETENTION_INTERVAL_SECONDS=3600

# SSE autenticado. Eventos guardam somente IDs/metadados e expiram automaticamente.
REALTIME_STREAM_SECONDS=25
REALTIME_STREAM_POLL_MS=750
REALTIME_EVENT_RETENTION_DAYS=7
# O servidor embutido `php -S` e sequencial; deixe false para usar polling local.
REALTIME_ALLOW_CLI_SERVER=false

# Para aceitar videos de perfil de ate 25 MB, configure no PHP/EasyHost:
# upload_max_filesize=26M e post_max_size=30M (ou valores maiores).

SEED_DEMO_USERS=false
# Creates the versioned MVP marketplace catalog once (five companions, one store and products).
SEED_MVP_CONTENT=false
SEED_USER_EMAIL=
SEED_USER_PASSWORD=change-me-user-password
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=change-me-admin-password
