APP_ENV=production
APP_DEBUG=false
APP_AUTO_MIGRATE=true
APP_FRONTEND_URL=https://www.chambre-rose.com
APP_CORS_ALLOWED_ORIGINS=https://www.chambre-rose.com

# Use either DATABASE_URL or the individual DB_* values.
DATABASE_URL=
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chambre_rose
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Generate at least 32 random bytes. Never commit the real value.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=180

# Easyhost's PHP mail transport works without mailbox credentials. SMTP remains available when configured.
MAIL_TRANSPORT=mail
MAIL_FROM_ADDRESS=no-reply@chambre-rose.com
MAIL_FROM_NAME=Chambre Rose
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true

PASSWORD_RESET_TTL_MINUTES=30
PHOTO_STORAGE_PATH=
SEED_PRODUCTS_FORCE_REFRESH=false
SEED_DEMO_USERS=false
